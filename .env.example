# Copy to .env.local and fill for local dev / Vercel env

# Database - Vercel Postgres (Neon)
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="change-this-to-32+chars-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob for payment proofs, thumbnails, resources
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token"

# Optional
# NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
